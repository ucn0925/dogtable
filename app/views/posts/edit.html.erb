<div class="container post-edit-page">
  <div class="post-edit-card">

    <h1 class="post-edit-title">口コミを編集する</h1> 

    <%= form_with(model: [@shop, @post], local: true) do |f| %>

       <!-- 必須項目 -->
      <p class="dt-required-note">
        <span class="dt-required">* </span>は必須項目です
      </p>

      <div class="mb-3">
        <%= f.label :shop, "店舗名", class:"form-label" %>

        <div class="form-control post-shop-name">
            <%= @shop.name %>
        </div>
      </div>

      <!-- 入力フォーム -->  
      <%= render "form", post: @post, shop: @shop, f: f %>

      <!-- 投稿済み画像 -->
      <% if @post.images.attached? %>
        <hr class="post-edit-divider">

        <div class="post-images-section">
          <h5 class="mb-3">投稿済みの画像</h5>

            <div class="post-images">
              <% @post.images.each do |image| %>
                <div class="post-image-item">
                  <%= image_tag image.variant(resize_to_limit: [200, 200]),
                        class: "post-edit-image" %>

                  <%= link_to(
                        destroy_image_shop_post_path(@post.shop, @post, image_id: image.id),
                        {
                          data: { 
                            turbo_method: :delete, 
                            turbo_confirm: "この画像を削除しますか？"
                          },
                          class: "image-delete"
                        }
                      ) do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>                  
                </div>
              <% end %>
            </div>
        </div>
      <% end %>

      <!-- ボタン専用フォーム -->
      <div class="post-edit-buttons">
        <%= f.submit "更新する", 
            class: "dt-btn dt-btn-primary" %>
        
        <%= link_to "この口コミを削除",
            shop_post_path(@shop, @post),
            data: {
              turbo_method: :delete,
              turbo_confirm: "この口コミを削除しますか？"
            },
            class: "dt-btn dt-btn-danger dt-btn-sm delete-post" %>
      </div>
    <% end %>

    <!-- 戻るリンク -->
    <div class="post-edit-back">
      <%= link_to shop_path(@shop), 
          class: "post-back-link" do %>
        <i class="fa-solid fa-chevron-left"></i>
        戻る
      <% end %>
    </div>

  </div>
</div>