<div class="container timeline-container py-4"> 

  <% if @posts.any? %> 
    <% @posts.each do |post| %>
      
      <div class="timeline-card position-relative">

        <%= link_to "", shop_post_path(post.shop, post), class: "stretched-link" %>

        <div class="timeline-shop">
          <%= link_to post.shop.name, shop_path(post.shop), onclick: "event.stopPropagation();" %>
          <span class="shop-area">
            （<%= post.shop.city.name %>）
          </span>
        </div>

        <div class="timeline-header">
          <% if post.user.profile_image.attached? %>
            <%= image_tag post.user.profile_image, class: "avatar avatar-sm" %>
          <% else %>
            <%= image_tag "default_user.png", class: "avatar avatar-sm" %>
          <% end %>

          <div>
            <strong><%= post.user.name %></strong><br>
            <small class="text-muted">
              <%= post.created_at.strftime("%Y/%m/%d %H:%M") %>
            </small>
          </div>
        </div>

        <% if post.visited_on.present? || post.visit_scene.present? || post.dog_size.present? %>
          <div class="timeline-visit-info">

            <% if post.visited_on.present? %>
              <span class="timeline-meta-pill">
                <i class="fa-solid fa-calendar-check"></i>
                <%= post.visited_on.strftime("%Y/%m") %>
              </span>
            <% end %>

            <% if post.visit_scene.present? %>
              <span class="timeline-meta-pill">
                <%= post.visit_scene %>
              </span>
            <% end %>

            <% if post.dog_size.present? %>
              <span class="timeline-meta-pill">
                with
                <%= case post.dog_size 
                  when "small" then "小型犬"
                  when "medium" then "中型犬"
                  when "large" then "大型犬"
                end %>

                <% if post.user.dog&.dog_image&.attached? %>
                  <%= image_tag post.user.dog.dog_image, class:"dog-icon" %>
                <% else %>
                  <%= image_tag "default_dog.png", class: "dog-icon" %>
                <% end %>
              </span>
            <% end %>
          </div>
        <% end %>

        <div class="timeline-body">

          <div class="timeline-content">

            <div class="timeline-rating">
              <% 5.times do |i| %>
                <span class="<%= i < post.rating_overall.to_i ? 'dt-star' : 'dt-star-muted' %>">★</span>
              <% end %>
            </div>

            <% if post.content.present? %>
              <p class="timeline-comment">
                <%= truncate(post.content, length: 60) %>
              </p>
            <% end %>

          </div>

          <% if post.images.attached? %>
            <div class="timeline-images">
              <% post.images.first(2).each do |image| %>
                <%= image_tag image %>
              <% end %>
            </div>
          <% end %>
          
          <div class="dt-like dt-like--timeline"> 
            <div class="dt-like-left">

              <%= button_to shop_post_post_favorite_path(post.shop, post),
                    method: post.favorited_by?(current_user) ? :delete : :post,
                    class: "dt-like-btn" do %>
                <% if post.favorited_by?(current_user) %>
                  <i class="fa-solid fa-heart"></i>
                <% else %>
                  <i class="fa-regular fa-heart"></i>
                <% end %>

              <% end %>

              <span class="dt-like-count">
                <%= post.post_favorites.count %>
              </span>

            </div>
          </div>

        </div>
      </div>    
    
    <% end %>

  <% else %>
    <p>フォローしている人の投稿はまだありません。</p>
  <% end %> 
</div>
