<div class="container shop-edit-page">
  <div class="shop-edit-card">
         
    <h1 class="shop-edit-title">店舗情報を編集する</h1>

    <%= render "form", shop: @shop %>

    <hr class="shop-edit-divider">

    <div class="shop-images-section">
      <h2 class="shop-edit-section-title">登録済みの画像</h2>

      <% if @shop.images.attached? %>
        <div class="shop-images">
          <% @shop.images.each do |image| %>
              <div class="shop-image-item">
                <%= image_tag image.variant(resize_to_limit: [200, 200]).processed,
                              class: "shop-edit-image" %>

                <%= link_to destroy_image_shop_path(image.id),
                      data: { 
                        turbo_method: :delete, 
                        turbo_confirm: "この画像を削除してよろしいですか？" 
                      },
                      class: "shop-image-delete" do %>
                  <i class="fa-solid fa-trash"></i>
                <% end %>

              </div>
          <% end %>
        </div>
      <% else %>
        <p class="shop-no-images">登録された画像はありません。</p>
      <% end %>
    </div>

    <div class="shop-edit-back">
      <%= link_to shop_path(@shop), 
            class: "shop-back-link" do %>
        <i class="fa-solid fa-chevron-left"></i>
        戻る
      <% end %>
    </div>

  </div>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>"></script>
