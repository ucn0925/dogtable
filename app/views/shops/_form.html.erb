<%# app/views/shops/_form.html.erb %>

<% if shop.errors.any? %>
  <div class="shop-form-errors">
    <h2 class="shop-form-errors-title">
      <%= shop.errors.count %>件のエラーがあります
    </h2>

    <ul class="shop-form-errors-list">
      <% shop.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: shop, local: true, id: "shop-form" do |f| %>

  <!-- 店名 -->
  <div class="dt-form-group">
    <%= f.label :name, class: "dt-form-label" do %>
      店名<span class="dt-required"> *</span>
    <% end %>
    <%= f.text_field :name, class: "dt-form-control" %>
  </div>

   <!-- エリア -->
  <div class="dt-form-group">
    <%= f.label :block_id, class: "dt-form-label" do %>
      エリア<span class="dt-required"> *</span>
    <% end %>

    <%= f.collection_select :block_id, 
          Block.all, :id, :name, 
          { prompt: "エリアを選択してください" },
          { class: "dt-form-select" } %>
  </div>

  <!-- 市町村 -->
  <div class="dt-form-group">
    <%= f.label :city_id, class: "dt-form-label" do %>
      市町村<span class="dt-required"> *</span>
    <% end %>

    <%= f.select :city_id, 
          options_for_select(
              City.all.map { |city|
                [
                  city.name,
                  city.id,
                  { data: { block_id: city.block_id } }
                ]
              },
              shop.city_id
          ),
          { prompt: "市町村を選択してください" },
          { class: "dt-form-select" } %>
  </div>

  <!-- 住所 -->
  <div class="dt-form-group">
    <%= f.label :address, class: "dt-form-label" do %>
      住所<span class="dt-required"> *</span>
    <% end %>
    <%= f.text_field :address, 
          class: "dt-form-control",
          id: "shop-address" %>
  </div>

    <%# 緯度・経度（hidden） %>
    <%= f.hidden_field :latitude, id: "shop-latitude" %>
    <%= f.hidden_field :longitude, id: "shop-longitude" %>

    <!-- ジャンル -->
    <div class="dt-form-group">
      <%= f.label :genre_id, class: "dt-form-label" do %>
        ジャンル<span class="dt-required"> *</span>
      <% end %>

      <%= f.collection_select :genre_id, 
            Genre.all, :id, :name, 
            { prompt: "ジャンルを選択してください" },
            { class: "dt-form-select" } %>
    </div>

    <!-- 店舗写真 -->
    <div class="dt-form-group">
      <%= f.label :images, "店舗の写真", class: "dt-form-label" %>

      <%= f.file_field :images, 
            multiple: true, 
            accept: "image/*",
            class: "dt-form-control" %>
    </div>

   
    <!-- 営業時間 -->
    <div class="dt-form-group">
      <%= f.label :opening_hours, "営業時間", class: "dt-form-label" %>
      
      <%= f.text_field :opening_hours, 
            class: "dt-form-control",
            placeholder: "例）10:00〜18:00" %>
    </div>

    <!-- 定休日 -->
    <div class="dt-form-group">
      <%= f.label :closed_days, "定休日", class: "dt-form-label" %>
      <%= f.text_field :closed_days, 
            class: "dt-form-control",
            placeholder: "例）火曜・水曜" %>
    </div>

    <!-- 駐車場 -->
    <div class="dt-check">
      <%= f.check_box :parking %>
      <%= f.label :parking, "駐車場あり" %>
    </div>

    <!-- 犬連れ情報 -->
    <div class="shop-edit-section">

      <h2 class="shop-edit-section-title">犬連れ情報</h2> 

      <div class="dt-check">
        <%= f.check_box :inside_ok %>
        <%= f.label :inside_ok, "店内同伴OK" %>
      </div>

      <div class="dt-check">
        <%=f.check_box :terrace_ok %>
        <%= f.label :terrace_ok, "テラスOK" %>
      </div>

      <div class="dt-check">
        <%= f.check_box :dog_menu %>
        <%= f.label :dog_menu, "犬用メニュー" %>
      </div>

      <div class="dt-check">
        <%= f.check_box :lead_hook %>
        <%= f.label :lead_hook, "リードフック" %>
      </div>
    </div>

    <!-- 必須項目 -->
    <p class="shop-required-note">
      <span class="dt-required">* </span>は必須項目です
    </p>

    <!-- 送信ボタン -->
    <div class="shop-submit">
      <%= f.submit shop.new_record? ? "登録する" : "更新する",
            class: "dt-btn dt-btn-primary dt-btn-lg" %>
    </div>

    <!-- 一覧に戻る -->
    <div class="shop-form-back">
      <%= link_to shops_path,
            class: "shop-form-back-link" do %>
        <i class="fa-solid fa-chevron-left"></i>
        一覧に戻る
      <% end %>
    </div>

<% end %>

